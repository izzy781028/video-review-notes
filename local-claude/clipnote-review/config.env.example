# 複製到 ~/.config/clipnote/config.env 後填入，再執行 chmod 600 ~/.config/clipnote/config.env
# 片語的網址
CLIPNOTE_URL=https://video-review-notes.pages.dev
# Cloudflare Zero Trust → Access → Service Auth → Service Tokens 建立的服務權杖
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Google Drive 電腦版同步到本機的「片語審片」資料夾
# macOS 例：/Users/izzy/Library/CloudStorage/GoogleDrive-izzy.tang@gmail.com/我的雲端硬碟/片語審片
CLIPNOTE_DRIVE_DIR=
